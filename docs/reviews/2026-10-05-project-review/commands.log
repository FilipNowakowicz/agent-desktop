import tempfile, unittest, struct, fcntl, os
from pathlib import Path
from unittest.mock import Mock, patch
from agent_desktop import core
from agent_desktop.worker import Worker
from agent_desktop.atspi import Accessibility, REGISTRY
OUT=Path('reviews/2026-10-05-project-review').resolve()
class ReviewProbes(unittest.TestCase):
 def test_profile_delete_does_not_hold_lock(self):
  with tempfile.TemporaryDirectory(dir=OUT) as d, patch.dict(os.environ,AGENT_DESKTOP_STATE_DIR=d):
   p=core.profile_path('review'); (p/'home').mkdir(parents=True)
   def deletion(path):
    with (path/'lock').open('a') as lock:
     fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
   with patch('agent_desktop.core.shutil.rmtree',side_effect=deletion):
    self.assertTrue(core.delete_profile('review')['deleted'])
 def test_unstable_capture_still_returns_token(self):
  with tempfile.TemporaryDirectory(dir=OUT) as d:
   w=Worker.__new__(Worker); w.root=Path(d); w.virtual_pointer=Mock(output={'width':2,'height':2})
   w.observation=Mock(side_effect=['a','b','c','d','e','f'])
   w.command=lambda *args: Path(args[-1]).write_bytes(b'\x89PNG\r\n\x1a\n'+b'\0'*8+struct.pack('>II',2,2))
   self.assertEqual(w.screenshot()['observation'],'e'); self.assertEqual(w.observation.call_count,6)
 def test_wait_can_match_unrelated_window_element(self):
  with patch.object(core,'request',side_effect=[{'windows':[{'title':'Editor','app_id':'edit'}]},{'nodes':[{'name':'Saved','role':'label','text':'other app'}]}]):
   result=core.wait('unused',title='Editor',element='Saved')
   self.assertTrue(result['satisfied']); self.assertEqual(result['elements'][0]['text'],'other app')
 def test_wait_pause_ignores_timeout_and_session(self):
  with patch.object(core,'request') as request:
   result=core.wait('not-a-session',seconds=.02,timeout=.001)
   self.assertTrue(result['satisfied']); self.assertGreaterEqual(result['elapsed_ms'],20); request.assert_not_called()
 def test_action_post_observation_loses_partial_result(self):
  with patch.object(core,'request',side_effect=[{'delivered':True},core.DesktopError('human takeover')]):
   with self.assertRaises(core.DesktopError): core.run_actions('unused',[{'action':'type','text':'done'}],observation='baseline')
 def test_tree_limit_does_not_bound_application_nodes(self):
  a=Accessibility.__new__(Accessibility)
  a.children=lambda node: [('app'+str(i),'/root') for i in range(3)] if node==REGISTRY else []
  a.get=lambda *args:'app'
  result=a.tree(max_nodes=1)
  self.assertEqual(len(result['nodes']),3); self.assertFalse(result['truncated'])
 def test_release_succeeds_when_clipboard_clear_fails(self):
  w=Worker.__new__(Worker); w.control={'owner':'human','epoch':0}; w.takeover=None
  w.info={'id':'review','runtime':str(OUT),'wayland_display':'unused'}; w.save_control=Mock()
  with patch('agent_desktop.worker.clear_selection',side_effect=RuntimeError('unsupported')):
   self.assertEqual(w.release('review')['owner'],'agent')
 def test_ui_short_id_retargets_after_reset(self):
  w=Worker.__new__(Worker); w.ui_ids={'n'+str(i):str(i) for i in range(1,50001)}; w.ui_names={'old':'n1'}
  self.assertEqual(w.short_id('new'),'n1'); self.assertEqual(w.ui_ids['n1'],'new')
unittest.main(verbosity=2)
PY
