expected={'findings.jsonl','capabilities.json','options.json','plan.md','questions.md','report.md','commands.log'}
assert {x.name for x in p.iterdir()}==expected
f=[json.loads(l) for l in (p/'findings.jsonl').read_text().splitlines()]
ids={x['id'] for x in f}
for i,x in enumerate(f,1):
 assert x['id']==f'F{i:03d}' and len(x['title'])<=100 and set(x)=={'id','area','severity','title','detail','evidence','evidence_level','recommendation','effort','related'}
 for e in x['evidence']:
  m=re.fullmatch(r'([^: ]+):(\d+)',e)
  if m: assert pathlib.Path(m[1]).read_text().splitlines()[int(m[2])-1].strip(),e
for name in ['plan.md','questions.md','report.md']:
 for ref in re.findall(r'\bF\d{3}\b',(p/name).read_text()): assert ref in ids,ref
for x in json.loads((p/'capabilities.json').read_text()):
 assert set(x['finding_ids'])<=ids
print('Exactly seven files; valid sequential finding IDs, nonblank source anchors and cross-references.')
print('Severity counts:',dict(collections.Counter(x['severity'] for x in f)))
print('Report words:',len((p/'report.md').read_text().split()))
